# Meta / Instagram Developer Credentials
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
META_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
META_VERIFY_TOKEN="your_custom_webhook_verify_token_here"
INSTAGRAM_API_VERSION="v22.0"

# Database Connection (SQLite for zero-config local dev, or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Application Security Secrets
ENCRYPTION_SECRET="change_this_to_a_secure_random_32_byte_secret_key!"
SESSION_SECRET="change_this_to_a_secure_random_session_secret_key!"

# Application Settings
APP_URL="http://localhost:3000"
NODE_ENV="development"
